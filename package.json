{
  "name": "xplorer",
  "version": "1.0.0-alpha.1",
  "description": "Xplorer - a fast native Windows file manager",
  "type": "module",
  "license": "AGPL-3.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "native:restore": "dotnet restore apps/native/Xplorer.Native/Xplorer.Native.csproj -p:Platform=x64 -p:RuntimeIdentifier=win-x64",
    "native:build": "dotnet build apps/native/Xplorer.Native/Xplorer.Native.csproj -c Release -p:Platform=x64 -p:RuntimeIdentifier=win-x64",
    "marketplace:dev": "pnpm --filter xplorer-web run dev",
    "marketplace:db": "docker compose -f infra/docker-compose.yml up -d postgres",
    "extensions:build": "node scripts/build-extensions.mjs",
    "extensions:sign": "node scripts/sign-all-extensions.mjs",
    "extensions:dev": "node scripts/build-extensions.mjs --watch",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "dependencies": {
    "@crabnebula/tauri-plugin-drag": "^2.1.0",
    "@radix-ui/react-checkbox": "^1.1.5",
    "@radix-ui/react-select": "^2.1.7",
    "@tanstack/react-query": "^5.60.5",
    "@tanstack/react-virtual": "^3.13.19",
    "@tauri-apps/api": "^2.10.1",
    "@tauri-apps/plugin-dialog": "^2.6.0",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "clsx": "^2.1.1",
    "diff": "^8.0.3",
    "dompurify": "^3.3.3",
    "exceljs": "^4.4.0",
    "i18next": "^25.8.20",
    "i18next-browser-languagedetector": "^8.2.1",
    "lucide-react": "^0.542.0",
    "mammoth": "^1.12.0",
    "papaparse": "^5.5.3",
    "pdfjs-dist": "^5.3.93",
    "react": "^19.0.0",
    "react-compiler-runtime": "^1.0.0",
    "react-dom": "^19.0.0",
    "react-i18next": "^16.5.8",
    "react-pdf": "^10.0.1",
    "react-syntax-highlighter": "^15.6.1",
    "tailwind-merge": "^2.6.0",
    "wouter": "^3.3.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "20.16.11",
    "@typescript-eslint/eslint-plugin": "^8.57.1",
    "@typescript-eslint/parser": "^8.57.1",
    "esbuild": "^0.25.12",
    "eslint": "^10.0.3",
    "husky": "^9.1.7",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2"
  }
}
