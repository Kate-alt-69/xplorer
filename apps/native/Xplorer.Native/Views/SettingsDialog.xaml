<ContentDialog
    x:Class="Xplorer.Native.Views.SettingsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Loaded="SettingsDialog_Loaded">

    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMinWidth">780</x:Double>
        <x:Double x:Key="ContentDialogMaxWidth">960</x:Double>
    </ContentDialog.Resources>

    <Grid MinWidth="780" MaxWidth="960" MinHeight="540" MaxHeight="700">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="170" />
            <ColumnDefinition Width="1" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Row="0" Grid.ColumnSpan="3" Margin="2,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Settings" FontSize="24" FontWeight="SemiBold" />
                <TextBlock Text="Changes save automatically." Opacity="0.62" Margin="0,3,0,0" />
            </StackPanel>
            <Button
                Grid.Column="1"
                Width="36"
                Height="36"
                Padding="0"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                ToolTipService.ToolTip="Close settings"
                Click="SettingsClose_Click">
                <FontIcon Glyph="&#xE711;" FontSize="13" />
            </Button>
        </Grid>

        <ListView
            x:Name="SectionList"
            Grid.Row="1"
            Grid.Column="0"
            Margin="0,0,14,0"
            SelectionMode="Single"
            SelectionChanged="SectionList_SelectionChanged">
            <ListViewItem Content="General" Tag="General" />
            <ListViewItem Content="Explorer" Tag="Explorer" />
            <ListViewItem Content="Theme" Tag="Theme" />
            <ListViewItem Content="Terminal" Tag="Terminal" />
            <ListViewItem Content="System" Tag="System" />
        </ListView>

        <Border Grid.Row="1" Grid.Column="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" />

        <Grid Grid.Row="1" Grid.Column="2" Margin="22,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock x:Name="SectionTitle" Text="General" FontSize="21" FontWeight="SemiBold" />
                    <TextBlock x:Name="SectionDescription" Text="Everyday Xplorer behavior." Opacity="0.68" Margin="0,3,0,0" TextWrapping="Wrap" />
                </StackPanel>
                <TextBlock
                    x:Name="StatusText"
                    Grid.Column="1"
                    Margin="18,4,0,0"
                    MaxWidth="300"
                    TextWrapping="Wrap"
                    TextAlignment="Right"
                    Opacity="0.75" />
            </Grid>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="PageHost" Spacing="18" Padding="0,4,18,20" />
            </ScrollViewer>

            <!-- Kept outside PageHost because the existing settings renderer rebuilds that host on
                 each section switch. This card is still compiled XAML and only appears on Terminal. -->
            <Border
                x:Name="TerminalBehaviorCard"
                Grid.Row="2"
                Visibility="Collapsed"
                Margin="0,10,18,4"
                Padding="14,12"
                CornerRadius="8"
                BorderThickness="1"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="3">
                        <TextBlock Text="When Xplorer changes folders" FontWeight="SemiBold" />
                        <TextBlock
                            Text="Restart the active terminal in the new folder, or preserve it and open a new terminal tab."
                            Opacity="0.68"
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <ComboBox
                        x:Name="TerminalFolderBehaviorComboBox"
                        Grid.Column="1"
                        Width="190"
                        VerticalAlignment="Center"
                        SelectionChanged="TerminalFolderBehaviorComboBox_SelectionChanged">
                        <ComboBoxItem Content="Refresh active tab" />
                        <ComboBoxItem Content="Open new tab" />
                    </ComboBox>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</ContentDialog>
