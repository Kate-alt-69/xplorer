<ContentDialog
    x:Class="Xplorer.Native.Views.SettingsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Settings"
    PrimaryButtonText="Save"
    CloseButtonText="Cancel"
    DefaultButton="Primary">

    <Grid MinWidth="560" MaxWidth="680" MinHeight="380">
        <TabView IsAddTabButtonVisible="False">
            <TabViewItem Header="General">
                <ScrollViewer>
                    <StackPanel Padding="16" Spacing="14">
                        <ComboBox x:Name="ThemeComboBox" Header="Theme" SelectedIndex="0">
                            <ComboBoxItem Content="System" />
                            <ComboBoxItem Content="Dark" />
                            <ComboBoxItem Content="Light" />
                        </ComboBox>
                        <ToggleSwitch x:Name="ShowHiddenSwitch" Header="Show hidden files" OnContent="On" OffContent="Off" />
                        <ToggleSwitch x:Name="ShowExtensionsSwitch" Header="Show file extensions" OnContent="On" OffContent="Off" />
                    </StackPanel>
                </ScrollViewer>
            </TabViewItem>

            <TabViewItem Header="Explorer">
                <StackPanel Padding="16" Spacing="14">
                    <ComboBox x:Name="ViewModeComboBox" Header="Default view" SelectedIndex="0">
                        <ComboBoxItem Content="Medium" />
                        <ComboBoxItem Content="Large" />
                        <ComboBoxItem Content="Details" />
                    </ComboBox>
                    <ComboBox x:Name="SortModeComboBox" Header="Default sort" SelectedIndex="0">
                        <ComboBoxItem Content="Name" />
                        <ComboBoxItem Content="Date modified" />
                        <ComboBoxItem Content="Type" />
                        <ComboBoxItem Content="Size" />
                    </ComboBox>
                    <ToggleSwitch
                        x:Name="PerFolderViewSwitch"
                        Header="Remember view and sort per folder"
                        OffContent="Global"
                        OnContent="Per folder" />
                    <TextBlock
                        Text="Global is the default: view and sort changes apply everywhere. Turn this on only if you want folders to remember their own layout."
                        Opacity="0.7"
                        TextWrapping="Wrap" />
                </StackPanel>
            </TabViewItem>

            <TabViewItem Header="Terminal">
                <StackPanel Padding="16" Spacing="12">
                    <TextBlock
                        Text="Xplorer launches terminal sessions through Windows Terminal (wt.exe), not a raw Console Host window. Leave Command empty to use your Windows Terminal default profile."
                        TextWrapping="Wrap" />
                    <TextBox x:Name="TerminalCommandBox" Header="Custom command" PlaceholderText="Example: wsl.exe or pwsh.exe" />
                    <TextBox x:Name="TerminalArgumentsBox" Header="Arguments" PlaceholderText="Optional arguments" />
                </StackPanel>
            </TabViewItem>

            <TabViewItem Header="System">
                <StackPanel Padding="16" Spacing="12">
                    <TextBlock Text="Windows integration" FontSize="14" FontWeight="SemiBold" />
                    <TextBlock
                        Text="Files and folders inside Xplorer use the real Windows Shell context-menu stack. Xplorer does not inject hooks into Explorer.exe or unrelated apps."
                        TextWrapping="Wrap" />
                    <ToggleSwitch
                        x:Name="WindowsShellMenuSwitch"
                        Header="Add Open in Xplorer to Windows context menus"
                        OffContent="Off"
                        OnContent="Enabled" />
                    <TextBlock
                        Text="Adds an Xplorer-owned entry for folders, drives, and folder backgrounds under your user account. Turning it off removes only registry keys carrying Xplorer's ownership marker."
                        Opacity="0.7"
                        TextWrapping="Wrap" />
                    <TextBlock
                        x:Name="IntegrationStatusText"
                        Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                        TextWrapping="Wrap" />
                </StackPanel>
            </TabViewItem>
        </TabView>
    </Grid>
</ContentDialog>
