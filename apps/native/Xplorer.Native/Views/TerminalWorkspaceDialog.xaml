<ContentDialog
    x:Class="Xplorer.Native.Views.TerminalWorkspaceDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMinWidth">860</x:Double>
        <x:Double x:Key="ContentDialogMaxWidth">1180</x:Double>
    </ContentDialog.Resources>

    <Grid
        x:Name="DialogRoot"
        MinWidth="860"
        MaxWidth="1180"
        MinHeight="520"
        MaxHeight="760">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Margin="2,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="2">
                <StackPanel Orientation="Horizontal" Spacing="9">
                    <FontIcon Glyph="&#xE756;" FontSize="17" VerticalAlignment="Center" />
                    <TextBlock Text="Terminal" FontSize="22" FontWeight="SemiBold" />
                </StackPanel>
                <TextBlock
                    Text="In-app pseudoconsole • tabs stay alive when this popup is hidden"
                    Opacity="0.62"
                    FontSize="11" />
            </StackPanel>
            <Button
                Grid.Column="1"
                Width="36"
                Height="36"
                Padding="0"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                ToolTipService.ToolTip="Hide terminal (Tab + T)"
                Click="TerminalClose_Click">
                <FontIcon Glyph="&#xE711;" FontSize="13" />
            </Button>
        </Grid>

        <Border
            Grid.Row="1"
            CornerRadius="10"
            BorderThickness="1"
            BorderBrush="{ThemeResource XplorerBorderBrush}"
            Background="#0C0C0C"
            Padding="1">
            <TabView
                x:Name="TerminalTabs"
                Background="#0C0C0C"
                Foreground="#F2F2F2"
                IsAddTabButtonVisible="True"
                CanReorderTabs="True"
                TabWidthMode="SizeToContent"
                AddTabButtonClick="TerminalTabs_AddTabButtonClick"
                TabCloseRequested="TerminalTabs_TabCloseRequested"
                SelectionChanged="TerminalTabs_SelectionChanged" />
        </Border>
    </Grid>
</ContentDialog>
