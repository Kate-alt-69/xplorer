<Window
    x:Class="Xplorer.Native.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Xplorer">

    <Grid x:Name="Root" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.Resources>
            <SolidColorBrush x:Key="XplorerAccentBrush" Color="#6366F1" />
            <ItemsPanelTemplate x:Key="MediumItemsPanel">
                <ItemsWrapGrid Orientation="Horizontal" ItemWidth="116" ItemHeight="104" />
            </ItemsPanelTemplate>
            <ItemsPanelTemplate x:Key="LargeItemsPanel">
                <ItemsWrapGrid Orientation="Horizontal" ItemWidth="170" ItemHeight="148" />
            </ItemsPanelTemplate>

            <DataTemplate x:Key="MediumTileTemplate">
                <Grid Padding="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="68" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Width="60" Height="60">
                        <FontIcon
                            Glyph="{Binding FallbackGlyph}"
                            Foreground="{Binding IconBrush}"
                            FontSize="40"
                            Opacity="0.96" />
                        <Border CornerRadius="7" Background="Transparent">
                            <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
                        </Border>
                    </Grid>
                    <TextBlock
                        Grid.Row="1"
                        Text="{Binding DisplayName}"
                        Foreground="{ThemeResource XplorerTextBrush}"
                        TextAlignment="Center"
                        TextWrapping="Wrap"
                        TextTrimming="CharacterEllipsis"
                        MaxLines="2"
                        FontSize="12" />
                </Grid>
            </DataTemplate>

            <DataTemplate x:Key="LargeTileTemplate">
                <Grid Padding="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="102" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Width="92" Height="92">
                        <FontIcon
                            Glyph="{Binding FallbackGlyph}"
                            Foreground="{Binding IconBrush}"
                            FontSize="66"
                            Opacity="0.96" />
                        <Border CornerRadius="9" Background="Transparent">
                            <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
                        </Border>
                    </Grid>
                    <TextBlock
                        Grid.Row="1"
                        Text="{Binding DisplayName}"
                        Foreground="{ThemeResource XplorerTextBrush}"
                        TextAlignment="Center"
                        TextWrapping="Wrap"
                        TextTrimming="CharacterEllipsis"
                        MaxLines="2"
                        FontSize="12" />
                </Grid>
            </DataTemplate>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TabView
            x:Name="Tabs"
            Grid.Row="0"
            Height="38"
            Background="{ThemeResource XplorerSurfaceBrush}"
            IsAddTabButtonVisible="True"
            CanReorderTabs="True"
            TabWidthMode="SizeToContent"
            SelectionChanged="Tabs_SelectionChanged"
            TabCloseRequested="Tabs_TabCloseRequested"
            AddTabButtonClick="Tabs_AddTabButtonClick" />

        <Grid
            Grid.Row="1"
            Padding="10,6"
            ColumnSpacing="8"
            Background="{ThemeResource XplorerSurfaceBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox
                x:Name="AddressBox"
                Grid.Column="0"
                Height="32"
                Background="{ThemeResource XplorerSurfaceLightBrush}"
                BorderBrush="{ThemeResource XplorerBorderLightBrush}"
                Foreground="{ThemeResource XplorerTextBrush}"
                VerticalContentAlignment="Center"
                KeyDown="AddressBox_KeyDown" />
            <Button
                Grid.Column="1"
                MinWidth="42"
                Height="32"
                Content="Go"
                Foreground="{ThemeResource XplorerTextBrush}"
                Click="GoButton_Click" />
        </Grid>

        <CommandBar
            Grid.Row="2"
            Background="{ThemeResource XplorerSurfaceBrush}"
            Foreground="{ThemeResource XplorerTextBrush}"
            DefaultLabelPosition="Collapsed"
            IsDynamicOverflowEnabled="True">
            <AppBarButton Icon="Copy" Label="Copy" />
            <AppBarButton Icon="Cut" Label="Cut" />
            <AppBarButton Icon="Paste" Label="Paste" />
            <AppBarButton Icon="Delete" Label="Delete" />
            <AppBarSeparator />
            <AppBarButton Label="View">
                <AppBarButton.Icon>
                    <FontIcon Glyph="&#xE80A;" />
                </AppBarButton.Icon>
                <AppBarButton.Flyout>
                    <MenuFlyout>
                        <MenuFlyoutItem Text="Large icons" Click="ViewLarge_Click" />
                        <MenuFlyoutItem Text="Medium icons" Click="ViewMedium_Click" />
                        <MenuFlyoutItem Text="Details" Click="ViewDetails_Click" />
                    </MenuFlyout>
                </AppBarButton.Flyout>
            </AppBarButton>
            <AppBarButton Label="Size Map" IsEnabled="False" ToolTipService.ToolTip="Size Map is not implemented in the native rewrite yet">
                <AppBarButton.Icon>
                    <FontIcon Glyph="&#xE9D2;" />
                </AppBarButton.Icon>
            </AppBarButton>
            <CommandBar.SecondaryCommands>
                <AppBarButton Icon="Setting" Label="Settings" Click="SettingsButton_Click" />
            </CommandBar.SecondaryCommands>
        </CommandBar>

        <Grid Grid.Row="3" MinWidth="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="56" />
            </Grid.ColumnDefinitions>

            <Border
                Grid.Column="0"
                Background="{ThemeResource XplorerSurfaceBrush}"
                BorderBrush="{ThemeResource XplorerBorderBrush}"
                BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock
                        Margin="14,12,14,8"
                        Text="DRIVES"
                        Foreground="{ThemeResource XplorerTextSecondaryBrush}"
                        FontSize="11"
                        FontWeight="SemiBold" />
                    <ListView
                        x:Name="DriveList"
                        Grid.Row="1"
                        Background="Transparent"
                        ItemsSource="{x:Bind Drives}"
                        IsItemClickEnabled="True"
                        ItemClick="DriveList_ItemClick"
                        SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="10,8" ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon
                                        Glyph="&#xEDA2;"
                                        FontSize="16"
                                        Foreground="{ThemeResource XplorerBlueBrush}" />
                                    <StackPanel Grid.Column="1" Spacing="4">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock
                                                Text="{Binding DisplayName}"
                                                Foreground="{ThemeResource XplorerTextBrush}"
                                                TextTrimming="CharacterEllipsis" />
                                            <TextBlock
                                                Grid.Column="1"
                                                Text="{Binding FreeSpaceText}"
                                                Foreground="{ThemeResource XplorerTextSecondaryBrush}"
                                                FontSize="11" />
                                        </Grid>
                                        <ProgressBar
                                            Minimum="0"
                                            Maximum="100"
                                            Value="{Binding UsedPercent}"
                                            Height="3"
                                            Foreground="{StaticResource XplorerAccentBrush}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <Grid
                x:Name="FileArea"
                Grid.Column="1"
                MinWidth="0"
                Background="Transparent"
                RightTapped="FileArea_RightTapped">
                <GridView
                    x:Name="FileGrid"
                    Padding="8,6"
                    Background="Transparent"
                    ItemsSource="{x:Bind Items}"
                    ItemsPanel="{StaticResource MediumItemsPanel}"
                    ItemTemplate="{StaticResource MediumTileTemplate}"
                    SelectionMode="Extended"
                    IsMultiSelectCheckBoxEnabled="False"
                    DoubleTapped="FileList_ExactDoubleTapped"
                    RightTapped="FileList_MultiRightTapped"
                    SelectionChanged="FileList_SelectionChanged"
                    ContainerContentChanging="FileList_ContainerContentChanging">
                    <GridView.ItemContainerStyle>
                        <Style TargetType="GridViewItem">
                            <Setter Property="Margin" Value="1" />
                            <Setter Property="Padding" Value="2" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="VerticalContentAlignment" Value="Stretch" />
                        </Style>
                    </GridView.ItemContainerStyle>
                </GridView>

                <ListView
                    x:Name="FileDetails"
                    Visibility="Collapsed"
                    Background="Transparent"
                    ItemsSource="{x:Bind Items}"
                    SelectionMode="Extended"
                    DoubleTapped="FileList_ExactDoubleTapped"
                    RightTapped="FileList_MultiRightTapped"
                    SelectionChanged="FileList_SelectionChanged"
                    ContainerContentChanging="FileList_ContainerContentChanging">
                    <ListView.Header>
                        <Grid
                            Padding="12,7"
                            ColumnSpacing="10"
                            Background="{ThemeResource XplorerSurfaceBrush}"
                            BorderBrush="{ThemeResource XplorerBorderBrush}"
                            BorderThickness="0,0,0,1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="32" />
                                <ColumnDefinition Width="2.2*" />
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="1.2*" />
                                <ColumnDefinition Width="80" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="1" Text="Name" Foreground="{ThemeResource XplorerTextBrush}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="2" Text="Type" Foreground="{ThemeResource XplorerTextBrush}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="3" Text="Date modified" Foreground="{ThemeResource XplorerTextBrush}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="4" Text="Size" Foreground="{ThemeResource XplorerTextBrush}" FontWeight="SemiBold" />
                        </Grid>
                    </ListView.Header>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid MinHeight="38" Padding="8,3" ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="32" />
                                    <ColumnDefinition Width="2.2*" />
                                    <ColumnDefinition Width="1*" />
                                    <ColumnDefinition Width="1.2*" />
                                    <ColumnDefinition Width="80" />
                                </Grid.ColumnDefinitions>
                                <Grid Width="26" Height="26" VerticalAlignment="Center">
                                    <FontIcon
                                        Glyph="{Binding FallbackGlyph}"
                                        Foreground="{Binding IconBrush}"
                                        FontSize="20" />
                                    <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
                                </Grid>
                                <TextBlock Grid.Column="1" Text="{Binding DisplayName}" Foreground="{ThemeResource XplorerTextBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="2" Text="{Binding TypeName}" Foreground="{ThemeResource XplorerTextSecondaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="3" Text="{Binding ModifiedText}" Foreground="{ThemeResource XplorerTextSecondaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="4" Text="{Binding SizeText}" Foreground="{ThemeResource XplorerTextSecondaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>

            <StackPanel
                Grid.Column="2"
                Spacing="6"
                Padding="8,8"
                HorizontalAlignment="Stretch"
                Background="{ThemeResource XplorerRailBrush}">
                <Button Width="36" Height="36" HorizontalAlignment="Center" ToolTipService.ToolTip="Inspector" IsEnabled="False">
                    <FontIcon Glyph="&#xE890;" />
                </Button>
                <Button Width="36" Height="36" HorizontalAlignment="Center" ToolTipService.ToolTip="Search">
                    <FontIcon Glyph="&#xE721;" />
                </Button>
                <Button Width="36" Height="36" HorizontalAlignment="Center" ToolTipService.ToolTip="Settings" Click="SettingsButton_Click">
                    <FontIcon Glyph="&#xE713;" />
                </Button>
            </StackPanel>
        </Grid>

        <Grid
            Grid.Row="4"
            Padding="8,4"
            ColumnSpacing="6"
            Background="{ThemeResource XplorerRailBrush}"
            BorderBrush="{ThemeResource XplorerBorderBrush}"
            BorderThickness="0,1,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="4">
                <Button x:Name="BackButton" Width="32" Height="28" Click="BackButton_Click" ToolTipService.ToolTip="Back">
                    <FontIcon Glyph="&#xE72B;" />
                </Button>
                <Button x:Name="ForwardButton" Width="32" Height="28" Click="ForwardButton_Click" ToolTipService.ToolTip="Forward">
                    <FontIcon Glyph="&#xE72A;" />
                </Button>
                <Button Width="32" Height="28" Click="UpButton_Click" ToolTipService.ToolTip="Up">
                    <FontIcon Glyph="&#xE74A;" />
                </Button>
                <Button Width="32" Height="28" Click="RefreshButton_Click" ToolTipService.ToolTip="Refresh">
                    <FontIcon Glyph="&#xE72C;" />
                </Button>
                <Button Height="28" Click="TerminalButton_Click" ToolTipService.ToolTip="Open Windows Terminal here">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE756;" />
                        <TextBlock Text="Terminal" />
                    </StackPanel>
                </Button>
            </StackPanel>
            <TextBlock
                x:Name="StatusText"
                Grid.Column="1"
                VerticalAlignment="Center"
                Margin="10,0"
                Foreground="{ThemeResource XplorerTextSecondaryBrush}"
                TextTrimming="CharacterEllipsis" />
            <TextBlock
                Grid.Column="2"
                VerticalAlignment="Center"
                Text="Native WinUI"
                Foreground="{ThemeResource XplorerTextMutedBrush}"
                FontSize="11" />
        </Grid>
    </Grid>
</Window>
