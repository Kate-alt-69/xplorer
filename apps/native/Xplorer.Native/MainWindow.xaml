<Window
    x:Class="Xplorer.Native.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Xplorer">

    <Grid
        x:Name="Root"
        Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
        Loaded="ChromeRoot_Loaded">
        <Grid.Resources>
            <ItemsPanelTemplate x:Key="MediumItemsPanel">
                <ItemsWrapGrid Orientation="Horizontal" ItemWidth="116" ItemHeight="104" />
            </ItemsPanelTemplate>
            <ItemsPanelTemplate x:Key="LargeItemsPanel">
                <ItemsWrapGrid Orientation="Horizontal" ItemWidth="170" ItemHeight="148" />
            </ItemsPanelTemplate>

            <Style x:Key="XplorerChromeButtonStyle" TargetType="Button">
                <Setter Property="MinWidth" Value="28" />
                <Setter Property="Height" Value="28" />
                <Setter Property="Padding" Value="6,3" />
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{ThemeResource XplorerTextSecondaryBrush}" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
            </Style>

            <Style x:Key="XplorerSidebarButtonStyle" TargetType="Button">
                <Setter Property="Height" Value="30" />
                <Setter Property="Margin" Value="7,0" />
                <Setter Property="Padding" Value="8,4" />
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{ThemeResource XplorerTextSecondaryBrush}" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            </Style>

            <Style x:Key="XplorerRailButtonStyle" TargetType="Button">
                <Setter Property="Width" Value="40" />
                <Setter Property="Height" Value="40" />
                <Setter Property="Margin" Value="4,2" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="CornerRadius" Value="5" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{ThemeResource XplorerTextSecondaryBrush}" />
                <Setter Property="HorizontalAlignment" Value="Center" />
            </Style>

            <Style x:Key="XplorerDetailsItemStyle" TargetType="ListViewItem">
                <Setter Property="MinHeight" Value="40" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="0" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="VerticalContentAlignment" Value="Stretch" />
            </Style>

            <DataTemplate x:Key="MediumTileTemplate">
                <Grid Padding="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="68" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Width="60" Height="60">
                        <FontIcon
                            Glyph="{Binding FallbackGlyph}"
                            Foreground="{Binding IconBrush}"
                            FontSize="40"
                            Opacity="0.96" />
                        <Border CornerRadius="7" Background="Transparent">
                            <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
                        </Border>
                    </Grid>
                    <TextBlock
                        Grid.Row="1"
                        Text="{Binding DisplayName}"
                        Foreground="{ThemeResource XplorerTextBrush}"
                        TextAlignment="Center"
                        TextWrapping="Wrap"
                        TextTrimming="CharacterEllipsis"
                        MaxLines="2"
                        FontSize="12" />
                </Grid>
            </DataTemplate>

            <DataTemplate x:Key="LargeTileTemplate">
                <Grid Padding="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="102" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Width="92" Height="92">
                        <FontIcon
                            Glyph="{Binding FallbackGlyph}"
                            Foreground="{Binding IconBrush}"
                            FontSize="66"
                            Opacity="0.96" />
                        <Border CornerRadius="9" Background="Transparent">
                            <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
                        </Border>
                    </Grid>
                    <TextBlock
                        Grid.Row="1"
                        Text="{Binding DisplayName}"
                        Foreground="{ThemeResource XplorerTextBrush}"
                        TextAlignment="Center"
                        TextWrapping="Wrap"
                        TextTrimming="CharacterEllipsis"
                        MaxLines="2"
                        FontSize="12" />
                </Grid>
            </DataTemplate>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Compact native tab strip. The system title bar remains the real Windows caption area. -->
        <TabView
            x:Name="Tabs"
            Grid.Row="0"
            Height="32"
            Background="{ThemeResource XplorerSurfaceBrush}"
            Foreground="{ThemeResource XplorerTextBrush}"
            BorderBrush="{ThemeResource XplorerBorderBrush}"
            BorderThickness="0,0,0,1"
            IsAddTabButtonVisible="True"
            CanReorderTabs="True"
            TabWidthMode="SizeToContent"
            SelectionChanged="Tabs_SelectionChanged"
            TabCloseRequested="Tabs_TabCloseRequested"
            AddTabButtonClick="Tabs_AddTabButtonClick" />

        <!-- Xplorer-style path bar. Search is injected as the third column by MainWindow.Search.cs. -->
        <Grid
            x:Name="AddressChrome"
            Grid.Row="1"
            Height="38"
            Padding="10,5"
            ColumnSpacing="8"
            Background="{ThemeResource XplorerSurfaceBrush}"
            BorderBrush="{ThemeResource XplorerBorderBrush}"
            BorderThickness="0,0,0,1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>
            <Button
                Grid.Column="0"
                Width="28"
                Style="{StaticResource XplorerChromeButtonStyle}"
                ToolTipService.ToolTip="Toggle sidebar"
                Click="SidebarToggleButton_Click">
                <FontIcon Glyph="&#xE700;" FontSize="14" />
            </Button>
            <TextBox
                x:Name="AddressBox"
                Grid.Column="1"
                Height="28"
                MinWidth="0"
                Padding="9,1"
                Background="{ThemeResource XplorerSurfaceLightBrush}"
                BorderBrush="{ThemeResource XplorerBorderLightBrush}"
                Foreground="{ThemeResource XplorerTextBrush}"
                FontSize="12"
                VerticalContentAlignment="Center"
                KeyDown="AddressBox_KeyDown" />
        </Grid>

        <!-- Keep this a CommandBar so native file-operation wiring and XML themes remain compatible.
             The content side mirrors old Xplorer's Sort/View/Size Map strip; native actions sit right. -->
        <CommandBar
            x:Name="OperationBar"
            Grid.Row="2"
            Height="38"
            Padding="8,0"
            Background="{ThemeResource XplorerSurfaceBrush}"
            Foreground="{ThemeResource XplorerTextBrush}"
            BorderBrush="{ThemeResource XplorerBorderBrush}"
            BorderThickness="0,0,0,1"
            DefaultLabelPosition="Collapsed"
            IsDynamicOverflowEnabled="True">
            <CommandBar.Content>
                <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                    <Button Style="{StaticResource XplorerChromeButtonStyle}" MinWidth="82">
                        <Button.Flyout>
                            <MenuFlyout>
                                <MenuFlyoutItem Text="Name" Click="ChromeSortName_Click" />
                                <MenuFlyoutItem Text="Date modified" Click="ChromeSortDate_Click" />
                                <MenuFlyoutItem Text="Type" Click="ChromeSortType_Click" />
                                <MenuFlyoutItem Text="Size" Click="ChromeSortSize_Click" />
                            </MenuFlyout>
                        </Button.Flyout>
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <TextBlock x:Name="SortModeLabel" Text="Name" FontSize="12" />
                            <FontIcon Glyph="&#xE70D;" FontSize="10" />
                        </StackPanel>
                    </Button>

                    <Rectangle Width="1" Height="16" Fill="{ThemeResource XplorerBorderBrush}" Margin="3,0" />

                    <Button Style="{StaticResource XplorerChromeButtonStyle}" MinWidth="110">
                        <Button.Flyout>
                            <MenuFlyout>
                                <MenuFlyoutItem Text="Large icons" Click="ChromeViewLarge_Click" />
                                <MenuFlyoutItem Text="Medium icons" Click="ChromeViewMedium_Click" />
                                <MenuFlyoutItem Text="Details" Click="ChromeViewDetails_Click" />
                            </MenuFlyout>
                        </Button.Flyout>
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <FontIcon Glyph="&#xE8A9;" FontSize="14" />
                            <TextBlock x:Name="ViewModeLabel" Text="Details" FontSize="12" />
                            <FontIcon Glyph="&#xE70D;" FontSize="10" />
                        </StackPanel>
                    </Button>

                    <Rectangle Width="1" Height="16" Fill="{ThemeResource XplorerBorderBrush}" Margin="3,0" />

                    <Button
                        Style="{StaticResource XplorerChromeButtonStyle}"
                        MinWidth="78"
                        IsEnabled="False"
                        ToolTipService.ToolTip="Size Map is not implemented in the native rewrite yet">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <FontIcon Glyph="&#xE9D2;" FontSize="14" />
                            <TextBlock Text="Size Map" FontSize="12" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </CommandBar.Content>

            <AppBarButton Icon="Copy" Label="Copy" />
            <AppBarButton Icon="Cut" Label="Cut" />
            <AppBarButton Icon="Paste" Label="Paste" />
            <AppBarButton Icon="Delete" Label="Delete" />
            <AppBarSeparator />
            <AppBarButton Label="Terminal" Click="TerminalButton_Click">
                <AppBarButton.Icon>
                    <FontIcon Glyph="&#xE756;" />
                </AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton Icon="Setting" Label="Settings" Click="SettingsButton_Click" />
        </CommandBar>

        <Grid x:Name="ShellGrid" Grid.Row="3" MinWidth="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="256" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="48" />
            </Grid.ColumnDefinitions>

            <!-- No File Tree: old Xplorer visual hierarchy, but only the useful quick locations + drives. -->
            <Border
                x:Name="SidebarBorder"
                Grid.Column="0"
                Background="{ThemeResource XplorerSurfaceBrush}"
                BorderBrush="{ThemeResource XplorerBorderBrush}"
                BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Padding="0,7,0,8" Spacing="1">
                        <TextBlock
                            Margin="12,0,12,4"
                            Text="QUICK ACCESS"
                            Foreground="{ThemeResource XplorerTextMutedBrush}"
                            FontSize="10"
                            FontWeight="SemiBold" />

                        <Button Style="{StaticResource XplorerSidebarButtonStyle}" Tag="Home" Click="SidebarLocation_Click">
                            <Grid ColumnSpacing="9">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="18" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xE80F;" FontSize="14" Foreground="{ThemeResource XplorerBlueBrush}" />
                                <TextBlock Grid.Column="1" Text="Home" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            </Grid>
                        </Button>
                        <Button Style="{StaticResource XplorerSidebarButtonStyle}" Tag="Desktop" Click="SidebarLocation_Click">
                            <Grid ColumnSpacing="9">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="18" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xE7F4;" FontSize="14" />
                                <TextBlock Grid.Column="1" Text="Desktop" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            </Grid>
                        </Button>
                        <Button Style="{StaticResource XplorerSidebarButtonStyle}" Tag="Downloads" Click="SidebarLocation_Click">
                            <Grid ColumnSpacing="9">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="18" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xE896;" FontSize="14" />
                                <TextBlock Grid.Column="1" Text="Downloads" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            </Grid>
                        </Button>
                        <Button Style="{StaticResource XplorerSidebarButtonStyle}" Tag="Documents" Click="SidebarLocation_Click">
                            <Grid ColumnSpacing="9">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="18" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xE8A5;" FontSize="14" />
                                <TextBlock Grid.Column="1" Text="Documents" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            </Grid>
                        </Button>
                        <Button Style="{StaticResource XplorerSidebarButtonStyle}" Tag="Pictures" Click="SidebarLocation_Click">
                            <Grid ColumnSpacing="9">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="18" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xEB9F;" FontSize="14" />
                                <TextBlock Grid.Column="1" Text="Pictures" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            </Grid>
                        </Button>
                    </StackPanel>

                    <Border
                        Grid.Row="1"
                        Height="1"
                        Margin="10,0"
                        Background="{ThemeResource XplorerBorderBrush}" />

                    <TextBlock
                        Grid.Row="2"
                        Margin="12,10,12,6"
                        Text="DRIVES"
                        Foreground="{ThemeResource XplorerTextMutedBrush}"
                        FontSize="10"
                        FontWeight="SemiBold" />

                    <ListView
                        x:Name="DriveList"
                        Grid.Row="3"
                        Padding="4,0,4,8"
                        Background="Transparent"
                        ItemsSource="{x:Bind Drives}"
                        IsItemClickEnabled="True"
                        ItemClick="DriveList_ItemClick"
                        SelectionMode="None">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="2,0" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid MinHeight="42" Padding="8,5" ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="20" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon
                                        Glyph="&#xEDA2;"
                                        FontSize="15"
                                        Foreground="{ThemeResource XplorerBlueBrush}"
                                        VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock
                                                Text="{Binding DisplayName}"
                                                Foreground="{ThemeResource XplorerTextBrush}"
                                                FontSize="12"
                                                TextTrimming="CharacterEllipsis" />
                                            <TextBlock
                                                Grid.Column="1"
                                                Text="{Binding FreeSpaceText}"
                                                Foreground="{ThemeResource XplorerTextMutedBrush}"
                                                FontSize="10"
                                                Margin="6,0,0,0" />
                                        </Grid>
                                        <ProgressBar
                                            Minimum="0"
                                            Maximum="100"
                                            Value="{Binding UsedPercent}"
                                            Height="2"
                                            Foreground="{ThemeResource XplorerAccentBrush}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <Grid
                x:Name="FileArea"
                Grid.Column="1"
                MinWidth="0"
                Background="Transparent"
                RightTapped="FileArea_RightTapped">
                <GridView
                    x:Name="FileGrid"
                    Padding="8,6"
                    Background="Transparent"
                    ItemsSource="{x:Bind Items}"
                    ItemsPanel="{StaticResource MediumItemsPanel}"
                    ItemTemplate="{StaticResource MediumTileTemplate}"
                    SelectionMode="Extended"
                    IsMultiSelectCheckBoxEnabled="False"
                    DoubleTapped="FileList_ExactDoubleTapped"
                    RightTapped="FileList_MultiRightTapped"
                    SelectionChanged="FileList_SelectionChanged"
                    ContainerContentChanging="FileList_ContainerContentChanging">
                    <GridView.ItemContainerStyle>
                        <Style TargetType="GridViewItem">
                            <Setter Property="Margin" Value="1" />
                            <Setter Property="Padding" Value="2" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="VerticalContentAlignment" Value="Stretch" />
                        </Style>
                    </GridView.ItemContainerStyle>
                </GridView>

                <ListView
                    x:Name="FileDetails"
                    Visibility="Collapsed"
                    Background="Transparent"
                    ItemsSource="{x:Bind Items}"
                    SelectionMode="Extended"
                    ItemContainerStyle="{StaticResource XplorerDetailsItemStyle}"
                    DoubleTapped="FileList_ExactDoubleTapped"
                    RightTapped="FileList_MultiRightTapped"
                    SelectionChanged="FileList_SelectionChanged"
                    ContainerContentChanging="FileList_ContainerContentChanging">
                    <ListView.Header>
                        <Grid
                            Height="34"
                            Padding="10,0"
                            ColumnSpacing="10"
                            Background="{ThemeResource XplorerSurfaceBrush}"
                            BorderBrush="{ThemeResource XplorerBorderBrush}"
                            BorderThickness="0,0,0,1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="38" />
                                <ColumnDefinition Width="4.8*" />
                                <ColumnDefinition Width="1.4*" />
                                <ColumnDefinition Width="1.4*" />
                                <ColumnDefinition Width="2*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                Grid.Column="1"
                                Text="Name"
                                Foreground="{ThemeResource XplorerTextMutedBrush}"
                                FontSize="11"
                                FontWeight="SemiBold"
                                VerticalAlignment="Center" />
                            <TextBlock
                                Grid.Column="2"
                                Text="Size"
                                Foreground="{ThemeResource XplorerTextMutedBrush}"
                                FontSize="11"
                                FontWeight="SemiBold"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center" />
                            <TextBlock
                                Grid.Column="3"
                                Text="Type"
                                Foreground="{ThemeResource XplorerTextMutedBrush}"
                                FontSize="11"
                                FontWeight="SemiBold"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                            <TextBlock
                                Grid.Column="4"
                                Text="Date modified"
                                Foreground="{ThemeResource XplorerTextMutedBrush}"
                                FontSize="11"
                                FontWeight="SemiBold"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center" />
                        </Grid>
                    </ListView.Header>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid MinHeight="40" Padding="10,4" ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="38" />
                                    <ColumnDefinition Width="4.8*" />
                                    <ColumnDefinition Width="1.4*" />
                                    <ColumnDefinition Width="1.4*" />
                                    <ColumnDefinition Width="2*" />
                                </Grid.ColumnDefinitions>
                                <Grid Width="27" Height="27" VerticalAlignment="Center">
                                    <FontIcon
                                        Glyph="{Binding FallbackGlyph}"
                                        Foreground="{Binding IconBrush}"
                                        FontSize="20" />
                                    <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
                                </Grid>
                                <TextBlock
                                    Grid.Column="1"
                                    Text="{Binding DisplayName}"
                                    Foreground="{ThemeResource XplorerTextBrush}"
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    VerticalAlignment="Center"
                                    TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    Grid.Column="2"
                                    Text="{Binding SizeText}"
                                    Foreground="{ThemeResource XplorerTextMutedBrush}"
                                    FontSize="11"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    TextTrimming="CharacterEllipsis" />
                                <Border
                                    Grid.Column="3"
                                    Padding="7,2"
                                    CornerRadius="4"
                                    Background="{ThemeResource XplorerSurfaceBrush}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                                    <TextBlock
                                        Text="{Binding TypeName}"
                                        Foreground="{ThemeResource XplorerTextMutedBrush}"
                                        FontSize="10"
                                        TextTrimming="CharacterEllipsis" />
                                </Border>
                                <TextBlock
                                    Grid.Column="4"
                                    Text="{Binding ModifiedText}"
                                    Foreground="{ThemeResource XplorerTextMutedBrush}"
                                    FontSize="11"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    TextTrimming="CharacterEllipsis" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>

            <!-- Original Xplorer used a 48 px extension rail with 40 px buttons. -->
            <Grid
                x:Name="ExtensionsRail"
                Grid.Column="2"
                Background="{ThemeResource XplorerRailBrush}"
                BorderBrush="{ThemeResource XplorerBorderBrush}"
                BorderThickness="1,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Padding="0,5,0,0">
                    <Button
                        Style="{StaticResource XplorerRailButtonStyle}"
                        ToolTipService.ToolTip="Inspector"
                        IsEnabled="False">
                        <FontIcon Glyph="&#xE890;" FontSize="17" />
                    </Button>
                    <Button
                        Style="{StaticResource XplorerRailButtonStyle}"
                        ToolTipService.ToolTip="Search">
                        <FontIcon Glyph="&#xE721;" FontSize="17" />
                    </Button>
                </StackPanel>

                <Border
                    Grid.Row="2"
                    BorderBrush="{ThemeResource XplorerBorderBrush}"
                    BorderThickness="0,1,0,0"
                    Padding="0,4,0,3">
                    <Button
                        Style="{StaticResource XplorerRailButtonStyle}"
                        ToolTipService.ToolTip="Settings"
                        Click="SettingsButton_Click">
                        <FontIcon Glyph="&#xE713;" FontSize="17" />
                    </Button>
                </Border>
            </Grid>
        </Grid>

        <!-- Navigation remains at the bottom by design, but uses old Xplorer's compact status chrome. -->
        <Grid
            x:Name="BottomBar"
            Grid.Row="4"
            Height="32"
            Padding="6,2"
            ColumnSpacing="6"
            Background="{ThemeResource XplorerRailBrush}"
            BorderBrush="{ThemeResource XplorerBorderBrush}"
            BorderThickness="0,1,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="2">
                <Button
                    x:Name="BackButton"
                    Width="28"
                    Style="{StaticResource XplorerChromeButtonStyle}"
                    Click="BackButton_Click"
                    ToolTipService.ToolTip="Back">
                    <FontIcon Glyph="&#xE72B;" FontSize="13" />
                </Button>
                <Button
                    x:Name="ForwardButton"
                    Width="28"
                    Style="{StaticResource XplorerChromeButtonStyle}"
                    Click="ForwardButton_Click"
                    ToolTipService.ToolTip="Forward">
                    <FontIcon Glyph="&#xE72A;" FontSize="13" />
                </Button>
                <Button
                    Width="28"
                    Style="{StaticResource XplorerChromeButtonStyle}"
                    Click="UpButton_Click"
                    ToolTipService.ToolTip="Up">
                    <FontIcon Glyph="&#xE74A;" FontSize="13" />
                </Button>
                <Button
                    Width="28"
                    Style="{StaticResource XplorerChromeButtonStyle}"
                    Click="RefreshButton_Click"
                    ToolTipService.ToolTip="Refresh">
                    <FontIcon Glyph="&#xE72C;" FontSize="13" />
                </Button>
                <Rectangle Width="1" Height="15" Fill="{ThemeResource XplorerBorderBrush}" Margin="3,0" />
                <Button
                    Style="{StaticResource XplorerChromeButtonStyle}"
                    Height="26"
                    Click="TerminalButton_Click"
                    ToolTipService.ToolTip="Open terminal here">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <FontIcon Glyph="&#xE756;" FontSize="13" />
                        <TextBlock Text="Terminal" FontSize="11" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <TextBlock
                x:Name="StatusText"
                Grid.Column="1"
                VerticalAlignment="Center"
                Margin="8,0"
                Foreground="{ThemeResource XplorerTextMutedBrush}"
                FontSize="11"
                TextTrimming="CharacterEllipsis" />

            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <TextBlock
                    Text="Xplorer"
                    Foreground="{ThemeResource XplorerTextMutedBrush}"
                    FontSize="10"
                    Opacity="0.7" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
