<Application
    x:Class="Xplorer.Native.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <!-- WinUI controls such as TabView, CommandBar, GridView and ListView rely on the
                 framework's default control resources. Keeping only Xplorer's own brushes can
                 compile successfully but still fail at MainWindow.InitializeComponent() on a
                 machine where those styles are not already available from another resource scope. -->
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Xplorer-owned colors stay app-local so theme lookup never depends on an optional
                 app resource dictionary. Default is the dark palette used by WinUI's Default key. -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="ApplicationPageBackgroundThemeBrush" Color="#111116" />
                    <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="#33FFFFFF" />
                    <SolidColorBrush x:Key="SystemFillColorCriticalBrush" Color="#FFFF99A4" />
                    <SolidColorBrush x:Key="XplorerAccentBrush" Color="#6D6AFB" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="ApplicationPageBackgroundThemeBrush" Color="#F7F7FA" />
                    <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="#26000000" />
                    <SolidColorBrush x:Key="SystemFillColorCriticalBrush" Color="#FFC42B1C" />
                    <SolidColorBrush x:Key="XplorerAccentBrush" Color="#5B57E8" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <SolidColorBrush x:Key="ApplicationPageBackgroundThemeBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="SystemFillColorCriticalBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="XplorerAccentBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
