<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>Xplorer.Native</RootNamespace>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <AppxPackage>false</AppxPackage>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <DefaultLanguage>en-US</DefaultLanguage>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>1.0.0-alpha.1</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <ApplicationIcon>Assets\Xplorer.ico</ApplicationIcon>
    <XplorerHostPath>$(MSBuildThisFileDirectory)..\..\worker\target\release\xplorer.exe</XplorerHostPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.4.0" />
    <!-- Force creation of the app PRI for unpackaged/self-contained WinUI.  WinUI custom controls
         resolve their default styles through the application's MRT resource map; without an app PRI,
         Windows 10 can construct basic controls but TabView/XamlControlsResources fail while looking
         for ms-appx:///Microsoft.UI.Xaml/Themes/themeresources.xaml. -->
    <PRIResource Include="Strings\en-US\Resources.resw" />
  </ItemGroup>

  <Target Name="CopyXplorerRustHost" AfterTargets="Build" Condition="Exists('$(XplorerHostPath)')">
    <Copy SourceFiles="$(XplorerHostPath)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>
</Project>
