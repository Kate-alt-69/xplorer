# AI Integration (optional - features work without these)
# CLAUDE_API_KEY=your-api-key-here
# OPENAI_API_KEY=your-api-key-here

# Ollama (optional - defaults to localhost:11434)
# OLLAMA_BASE_URL=http://localhost:11434

# Marketplace (optional - defaults to https://xplorer.space/api)
# VITE_MARKETPLACE_URL=https://xplorer.space/api

# Extension signing key (64-char hex string, 32 bytes Ed25519 private key)
# Generate with: cd apps/src-tauri && cargo test generate_signing_keypair -- --nocapture
# NEVER commit this key. Store in .env only.
# EXTENSION_SIGNING_KEY=your-64-char-hex-key-here

# Logging (optional)
# RUST_LOG=xplorer=info,warn
